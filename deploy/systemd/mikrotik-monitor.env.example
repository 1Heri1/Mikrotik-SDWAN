# Environment file for the docker-less/systemd deployment path.
# Copy to /opt/mikrotik-monitor/backend/.env (referenced by
# EnvironmentFile= in mikrotik-monitor-backend.service) and fill in real
# values. This mirrors the root .env.example one-for-one; see that file for
# a description of every variable - only the DATABASE_URL host typically
# differs (127.0.0.1 here vs. the "postgres" service name under Docker).

ENV=prod
LOG_DIR=/var/log/mikrotik-monitor

DATABASE_URL=postgresql+asyncpg://mikrotik_monitor:change-me-strong-password@127.0.0.1:5432/mikrotik_monitor

JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FERNET_KEY=change-me-generate-a-fernet-key

CORS_ORIGINS=https://localhost

MIKROTIK_BACKEND=librouteros
MIKROTIK_HOST=192.0.2.1
MIKROTIK_PORT=8728
MIKROTIK_API_USER=monitor-api
MIKROTIK_API_PASSWORD=change-me
MIKROTIK_USE_SSL_REST=true
MIKROTIK_VERIFY_SSL=true

POLL_INTERVAL_SECONDS=60
OFFLINE_ALERT_THRESHOLD_MINUTES=10
ROUTER_UNREACHABLE_REALERT_MINUTES=30
SNAPSHOT_RETENTION_DAYS=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESS=
SMTP_USE_TLS=true
