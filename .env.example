# =============================================================================
# Mikrotik VPN Concentrator Monitor - environment configuration
#
# Copy this file to `.env` in the project root (Docker Compose reads it from
# here) and, for the systemd/docker-less deployment, also copy the relevant
# values into /opt/mikrotik-monitor/backend/.env (see deploy/systemd/).
#
# NEVER commit the real .env file - it is already listed in .gitignore.
# =============================================================================

# --- General ---------------------------------------------------------------
ENV=prod                      # "dev" or "prod"
LOG_DIR=/var/log/mikrotik-monitor

# --- PostgreSQL --------------------------------------------------------------
# Used directly by the "postgres" service in docker-compose.yml
POSTGRES_DB=mikrotik_monitor
POSTGRES_USER=mikrotik_monitor
POSTGRES_PASSWORD=change-me-strong-password

# Used by the backend to connect. Inside docker-compose the host is the
# service name "postgres"; for a docker-less/systemd install use 127.0.0.1
# (or the DB server's address) and the async driver postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://mikrotik_monitor:change-me-strong-password@postgres:5432/mikrotik_monitor

# --- JWT / sessions ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption at rest -------------------------------------------------------
# Fernet key used to encrypt router credentials and PPP secret passwords in DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend (only relevant if
# frontend and backend are served from different origins, e.g. local dev).
CORS_ORIGINS=https://localhost,https://127.0.0.1

# --- Mikrotik concentrator (fallback / bootstrap config) ----------------------
# These are only used to bootstrap the FIRST poll before an admin has saved a
# router configuration in the Settings page (which is stored, Fernet-encrypted,
# in the router_config DB table and takes precedence once present).
MIKROTIK_BACKEND=librouteros          # "librouteros" (RouterOS <7, default) or "rest" (RouterOS 7.x)
MIKROTIK_HOST=192.0.2.1
MIKROTIK_PORT=8728                    # librouteros default 8728 (8729 for API-SSL), REST default 443
MIKROTIK_API_USER=monitor-api
MIKROTIK_API_PASSWORD=change-me
MIKROTIK_USE_SSL_REST=true            # only relevant when MIKROTIK_BACKEND=rest
MIKROTIK_VERIFY_SSL=true              # set to false only for self-signed router certs you trust

# --- Scheduler / alerting thresholds (bootstrap defaults; editable live in Settings) ---
POLL_INTERVAL_SECONDS=60
OFFLINE_ALERT_THRESHOLD_MINUTES=10
ROUTER_UNREACHABLE_REALERT_MINUTES=30
SNAPSHOT_RETENTION_DAYS=30

# --- Telegram notifications (bootstrap defaults; editable live in Settings) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP notifications (optional, bootstrap defaults; editable live in Settings) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESS=
SMTP_USE_TLS=true

# --- Frontend build-time variable (frontend/.env) -----------------------------
# Only needed if the frontend calls the API from a different origin than it is
# served from. Leave empty to use relative "/api" paths (recommended, works
# with the bundled nginx reverse proxy).
VITE_API_BASE_URL=
